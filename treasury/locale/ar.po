msgid "Row #{0}: Due Date {1} must be after {2}."
msgstr "الصف رقم {0}: يجب أن يكون تاريخ الاستحقاق {1} بعد {2}."

msgid "The principal of the repayment schedule ({0}) must equal the drawdown amount ({1})."
msgstr "يجب أن يساوي أصل جدول السداد ({0}) مبلغ السحب ({1})."

msgid "Bank Facility {0} is {1}: drawdowns need an Active facility."
msgstr "التسهيل البنكي {0} {1}: يتطلب السحب تسهيلاً سارياً."

msgid "The Drawdown Date {0} is outside the facility period {1} - {2}."
