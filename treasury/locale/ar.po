msgstr "عدد الشيكات"

msgid "Installment Generator"
msgstr "مولّد الأقساط"

msgid "Describe the installments, then click Generate Cheques: the rows below are replaced."
msgstr "حدد بيانات الأقساط ثم اضغط \"توليد الشيكات\": سيتم استبدال السطور بالأسفل."

msgid "Number of Cheques to Generate"
msgstr "عدد الشيكات المطلوب توليدها"

msgctxt "Cheque Batch"
msgid "Frequency"
msgstr "التكرار"

msgid "Interval (Days)"
msgstr "الفاصل (أيام)"

