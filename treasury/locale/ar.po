# Phase 3 — Cheque Batch messages (treasury.pdc.batch, cheque_batch.py)
msgid "Interval (Days) must be greater than zero."
msgstr "يجب أن يكون الفاصل (أيام) أكبر من صفر."

msgid "Invalid Frequency: {0}"
msgstr "تكرار غير صحيح: {0}"

msgid "Amount per Cheque must be greater than zero."
msgstr "يجب أن يكون مبلغ الشيك الواحد أكبر من صفر."

msgid "Invalid Amount Mode: {0}"
msgstr "طريقة مبلغ غير صحيحة: {0}"

msgid "Total Amount to Split must be greater than zero."
msgstr "يجب أن يكون الإجمالي المطلوب تقسيمه أكبر من صفر."

msgid "The total {0} is too small to be split into {1} cheques."
msgstr "الإجمالي {0} أصغر من أن يُقسم على {1} شيك."

msgid "First Cheque No is required to number the cheques."
msgstr "رقم أول شيك مطلوب لترقيم الشيكات."

msgid "First Cheque No {0} must end with digits."
msgstr "يجب أن ينتهي رقم أول شيك {0} بأرقام."

msgid "Number of Cheques must be greater than zero."
msgstr "يجب أن يكون عدد الشيكات أكبر من صفر."

msgid "A batch can hold at most {0} cheques."
msgstr "لا يمكن أن يحتوي السند على أكثر من {0} شيك."

msgid "First Due Date is required."
msgstr "تاريخ أول استحقاق مطلوب."

msgid "The Handover / Receipt Date cannot be before the Issue Date."
msgstr "لا يمكن أن يكون تاريخ التسليم / الاستلام قبل تاريخ التحرير."

msgid "Add at least one cheque (use Generate Cheques to create the rows)."
msgstr "أضف شيكاً واحداً على الأقل (استخدم \"توليد الشيكات\" لإنشاء السطور)."

msgid "Row #{0}: Amount must be greater than zero."
msgstr "الصف #{0}: يجب أن يكون المبلغ أكبر من صفر."

msgid "Row #{0}: Due Date is required."
msgstr "الصف #{0}: تاريخ الاستحقاق مطلوب."

msgid "Row #{0}: Cheque No {1} is already used in row #{2}."
msgstr "الصف #{0}: رقم الشيك {1} مستخدم بالفعل في الصف #{2}."

msgid "Cheque Book {0} has only {1} free leaves; this batch needs {2}."
msgstr "دفتر الشيكات {0} به {1} ورقة متاحة فقط؛ وهذا السند يحتاج {2}."

msgid "Row #{0}: the Allocation Method is {1}; remove the reference."
msgstr "الصف #{0}: طريقة التخصيص هي {1}؛ احذف المرجع."

msgid "Row #{0}: Reference Type and Reference Name are both required."
msgstr "الصف #{0}: نوع المرجع واسم المرجع مطلوبان معاً."

msgid "Row #{0}: the Allocated Amount cannot be greater than the cheque amount."
msgstr "الصف #{0}: لا يمكن أن يكون المبلغ المخصص أكبر من مبلغ الشيك."

msgid "{0} {1}: {2} is allocated in this batch, but only {3} is still outstanding (other not posted cheques already allocate {4})."
msgstr "{0} {1}: تم تخصيص {2} في هذا السند، بينما المستحق المتبقي {3} فقط (شيكات أخرى غير مرحّلة تخصص عليه {4})."

msgid "Over Allocation"
msgstr "تخصيص زائد"

msgid "Row #{0}: {1}"
msgstr "الصف #{0}: {1}"

msgid "FIFO allocation of {0} cheques needs a {1} as the party."
msgstr "التخصيص على الأقدم أولاً للشيكات من نوع {0} يتطلب أن يكون الطرف {1}."

msgid "Generate or add the cheques first."
msgstr "قم بتوليد الشيكات أو إضافتها أولاً."

msgid "FIFO allocation needs the party account in the cheque currency {0} (it is in {1}). Allocate the rows manually."
msgstr "التخصيص على الأقدم أولاً يتطلب أن يكون حساب الطرف بعملة الشيك {0} (وهو بعملة {1}). قم بتخصيص السطور يدوياً."

msgid "You need permission to create PDC Cheques to submit a Cheque Batch."
msgstr "تحتاج صلاحية إنشاء الشيكات الآجلة لاعتماد سند الشيكات."

msgid "Cheque Batch {0}"
msgstr "سند الشيكات {0}"

msgid "Cheque Batch {0} cannot be cancelled because these cheques are handed over or posted: {1}. Bounce, return, replace or cancel each of them first."
msgstr "لا يمكن إلغاء سند الشيكات {0} لأن هذه الشيكات تم تسليمها أو ترحيلها: {1}. سجّل ارتداد أو إرجاع أو استبدال أو إلغاء كل منها أولاً."

msgid "Cancellation Not Allowed"
msgstr "الإلغاء غير مسموح"

msgid "Cheque Batch {0} cancelled"
msgstr "تم إلغاء سند الشيكات {0}"

msgid "Submit the Cheque Batch first."
msgstr "قم باعتماد سند الشيكات أولاً."

msgid "Only a draft Cheque Batch can be changed."
msgstr "لا يمكن تعديل سند الشيكات إلا وهو مسودة."

