# Cheque Book messages
msgid "Bank Account {0} must be a company bank account of {1}."
msgstr "يجب أن يكون الحساب البنكي {0} حساباً بنكياً للشركة {1}."

msgid "Start No must be greater than zero."
msgstr "يجب أن يكون رقم البداية أكبر من صفر."

msgid "Start No cannot be greater than End No."
msgstr "لا يمكن أن يكون رقم البداية أكبر من رقم النهاية."

msgid "The range of a cheque book cannot be changed after leaves have been used."
msgstr "لا يمكن تغيير نطاق دفتر الشيكات بعد استخدام أوراق منه."

msgid "The range {0} - {1} overlaps with Cheque Book {2} of the same bank account."
msgstr "النطاق {0} - {1} يتداخل مع دفتر الشيكات {2} لنفس الحساب البنكي."

msgid "Row #{0}: Cheque No {1} is cancelled more than once."
msgstr "الصف #{0}: رقم الشيك {1} ملغي أكثر من مرة."

msgid "Cheque No {0} is not a valid leaf number."
msgstr "رقم الشيك {0} ليس رقم ورقة صحيحاً."

msgid "Cheque No {0} is outside the range {1} - {2} of Cheque Book {3}."
msgstr "رقم الشيك {0} خارج نطاق دفتر الشيكات {3} ({1} - {2})."

msgid "Cheque Book {0} is already closed."
msgstr "دفتر الشيكات {0} مغلق بالفعل."

msgid "Cheque Book {0} is {1}; no cheque number can be allocated from it."
msgstr "دفتر الشيكات {0} حالته {1}؛ لا يمكن أخذ رقم شيك منه."

msgid "Cheque Book {0} has no free leaves left."
msgstr "لا توجد أوراق متاحة في دفتر الشيكات {0}."

msgid "A reason is required to cancel a leaf."
msgstr "يجب إدخال سبب لإلغاء الورقة."

msgid "Cheque No {0} is already cancelled."
msgstr "رقم الشيك {0} ملغي بالفعل."

msgid "Cheque No {0} is used by a PDC Cheque or a Security Cheque. Cancel that cheque instead."
msgstr "رقم الشيك {0} مستخدم في شيك آجل أو شيك ضمان. قم بإلغاء ذلك الشيك بدلاً من ذلك."

# PDC Cheque messages
msgid "Cheque {0} has accounting entries and cannot be deleted. Cancel it instead."
msgstr "الشيك {0} له قيود محاسبية ولا يمكن حذفه. قم بإلغائه بدلاً من ذلك."

msgid "Party Type must be one of: {0}."
msgstr "يجب أن يكون نوع الطرف أحد: {0}."

msgid "Party is required."
msgstr "الطرف مطلوب."

msgid "Bank Account is required for outgoing cheques."
msgstr "الحساب البنكي مطلوب للشيكات الصادرة."

msgid "Bank Account {0} has no GL account."
msgstr "الحساب البنكي {0} غير مرتبط بحساب في دليل الحسابات."

msgid "Exchange Rate cannot be negative."
msgstr "لا يمكن أن يكون سعر الصرف سالباً."

msgid "A cheque book can only be used on outgoing cheques."
msgstr "يمكن استخدام دفتر الشيكات مع الشيكات الصادرة فقط."

msgid "Cheque Book {0} does not belong to Bank Account {1}."
msgstr "دفتر الشيكات {0} لا يتبع الحساب البنكي {1}."

msgid "Cheque Book {0} is {1}."
msgstr "دفتر الشيكات {0} حالته {1}."

msgid "Cheque No {0} is a cancelled leaf of Cheque Book {1}."
msgstr "رقم الشيك {0} ورقة ملغاة من دفتر الشيكات {1}."

msgid "Cheque No is required."
msgstr "رقم الشيك مطلوب."

msgid "Cheque No {0} is already used on Bank Account {1} by {2}."
msgstr "رقم الشيك {0} مستخدم بالفعل على الحساب البنكي {1} في {2}."

msgid "The Original Due Date cannot be before the Issue Date."
msgstr "لا يمكن أن يكون تاريخ الاستحقاق الأصلي قبل تاريخ التحرير."

msgid "Row #{0}: Reference Type must be one of: {1}."
