msgstr "اختر اسم المرجع."

# Messages (Letter of Credit)
msgid "The new Expiry Date cannot be before the current one."
msgstr "لا يمكن أن يكون تاريخ الانتهاء الجديد قبل التاريخ الحالي."

msgid "The new Expiry Date cannot be before the amendment date."
msgstr "لا يمكن أن يكون تاريخ الانتهاء الجديد قبل تاريخ التعديل."

msgid "The charges cannot be negative."
msgstr "لا يمكن أن تكون المصاريف سالبة."

msgid "Nothing to amend: enter a new amount, a new expiry date or charges."
msgstr "لا يوجد ما يُعدَّل: أدخل مبلغاً جديداً أو تاريخ انتهاء جديداً أو مصاريف."

msgid "The increase"
msgstr "الزيادة"

msgid "Amendment charges of {0} {1}"
msgstr "مصاريف تعديل {0} {1}"

msgid "The documents amount must be greater than zero and at most {0} (amount plus tolerance)."
msgstr "يجب أن يكون مبلغ المستندات أكبر من صفر وألا يتجاوز {0} (المبلغ مع نسبة التجاوز)."

msgid "Documents charges of {0} {1}"
msgstr "مصاريف مستندات {0} {1}"

msgid "Only a Usance Letter of Credit is accepted; settle a Sight credit directly."
msgstr "القبول للاعتماد الآجل فقط؛ اعتماد الاطلاع يُسدَّد مباشرة."

msgid "The Maturity Date must be after the Acceptance Date."
msgstr "يجب أن يكون تاريخ الاستحقاق بعد تاريخ القبول."

msgid "The settlement amount must be greater than zero and at most the documents amount {0}."
msgstr "يجب أن يكون مبلغ السداد أكبر من صفر وألا يتجاوز مبلغ المستندات {0}."

msgid "Settlement of {0} {1}"
msgstr "سداد {0} {1}"

msgid "{0} {1} holds no cash margin."
msgstr "لا يوجد تأمين نقدي محتجز على {0} {1}."

msgid "Set the Charges Account (or the Commission Account) of {0}."
msgstr "حدد حساب المصاريف (أو حساب العمولات) لـ {0}."

msgid "Purchase Invoice {0} must be a submitted invoice of supplier {1} in company {2}."
msgstr "يجب أن تكون فاتورة الشراء {0} فاتورة معتمدة للمورد {1} في الشركة {2}."

msgid "Letter of Credit maturity"
msgstr "استحقاق اعتماد مستندي"

msgid "Letter of Credit {0} is settled and cannot be cancelled."
msgstr "الاعتماد المستندي {0} مسدد ولا يمكن إلغاؤه."

msgid "The Expiry Date must be after the Opening Date."
msgstr "يجب أن يكون تاريخ الانتهاء بعد تاريخ الفتح."

msgid "The Latest Shipment Date cannot be after the Expiry Date."
msgstr "لا يمكن أن يكون آخر موعد للشحن بعد تاريخ الانتهاء."

msgid "Usance Days are required for a Usance Letter of Credit."
msgstr "أيام الأجل مطلوبة للاعتماد الآجل."

msgid "Select the Supplier."
msgstr "اختر المورد."

msgid "Purchase Order {0} must be a submitted order of supplier {1} in company {2}."
msgstr "يجب أن يكون أمر الشراء {0} أمراً معتمداً للمورد {1} في الشركة {2}."

# Messages (Cheque Discounting)
msgid "Cheque Discounting {0} of Bank Facility {1}"
msgstr "خصم الشيكات {0} من التسهيل البنكي {1}"

msgid "Cheque Discounting {0} cannot be cancelled: cheques {1} are already settled or bounced."
msgstr "لا يمكن إلغاء خصم الشيكات {0}: الشيكات {1} تم سدادها أو ارتدت بالفعل."

msgid "Cheque Discounting {0} cancelled"
msgstr "تم إلغاء خصم الشيكات {0}"

msgid "Cheques {0} are not discounted and open in {1}."
msgstr "الشيكات {0} ليست مخصومة وقائمة في {1}."

msgid "No discounted cheque of {0} is due by {1}."
msgstr "لا يوجد شيك مخصوم في {0} مستحق حتى {1}."

msgid "Cheque {0} is not linked to a Cheque Discounting."
msgstr "الشيك {0} غير مرتبط بدفعة خصم شيكات."

msgid "Discounted cheque {0} ({1}) paid at maturity, {2}"
msgstr "الشيك المخصوم {0} ({1}) سُدِّد في استحقاقه، {2}"

msgid "Recourse of the bounced discounted cheque {0} ({1}), {2}"
msgstr "رجوع البنك بالشيك المخصوم المرتد {0} ({1})، {2}"

msgid "Cheque {0} is not open in Cheque Discounting {1}."
msgstr "الشيك {0} ليس قائماً في خصم الشيكات {1}."

msgid "The cheques of a submitted Cheque Discounting cannot be changed."
msgstr "لا يمكن تغيير شيكات دفعة خصم معتمدة."

msgid "Set the Liability Account (discounted cheques) of the {0} sub-limit of Bank Facility {1}."
msgstr "حدد حساب الالتزام (الأوراق المخصومة) للحد الفرعي {0} في التسهيل البنكي {1}."

msgid "The discount rate cannot be negative."
msgstr "لا يمكن أن يكون سعر الخصم سالباً."

msgid "Add at least one cheque."
msgstr "أضف شيكاً واحداً على الأقل."

msgid "Row #{0}: Cheque {1} appears more than once."
msgstr "الصف رقم {0}: الشيك {1} مكرر."

msgid "Row #{0}: Cheque {1} does not belong to company {2}."
msgstr "الصف رقم {0}: الشيك {1} لا يخص الشركة {2}."

msgid "Row #{0}: Cheque {1} is in {2}, but the facility is in {3}."
msgstr "الصف رقم {0}: الشيك {1} بعملة {2}، لكن التسهيل بعملة {3}."

msgid "The discount charges and the commission leave no net proceeds."
msgstr "مصاريف الخصم والعمولة لا تترك صافي متحصلات."

msgid "Discount Expense Account is required for the charges."
msgstr "حساب مصروف الخصم مطلوب للمصاريف."

msgid "Cheques must be given as a list."
msgstr "يجب إدخال الشيكات كقائمة."

msgid "Cheque {0} is not an incoming cheque."
msgstr "الشيك {0} ليس شيكاً وارداً."

msgid "Cheque {0} is {1}: only Received cheques can be discounted."
msgstr "الشيك {0} {1}: لا يمكن خصم إلا الشيكات المستلمة."

msgid "Cheque {0} must be posted to the party (in PDC Receivable) before it can be discounted; it is {1}."
msgstr "يجب ترحيل الشيك {0} على الطرف (في أوراق القبض) قبل خصمه؛ حالته {1}."

msgid "The Discount Date ({0}) of cheque {1} cannot be before {2}."
msgstr "لا يمكن أن يكون تاريخ خصم ({0}) الشيك {1} قبل {2}."

msgid "Cheque {0} is due on {1}: only cheques due after the Discount Date can be discounted."
msgstr "الشيك {0} يستحق في {1}: لا يمكن خصم إلا الشيكات المستحقة بعد تاريخ الخصم."

msgid "Cheque {0} is not discounted with {1}."
msgstr "الشيك {0} ليس مخصوماً في {1}."

