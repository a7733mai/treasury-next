# Messages (posting service)
msgid "Charges cannot be negative."
msgstr "لا يمكن أن تكون المصاريف سالبة."

msgid "An account for the charges is required."
msgstr "يلزم تحديد حساب للمصاريف."

msgid "Charges must be less than the amount."
msgstr "يجب أن تكون المصاريف أقل من المبلغ."

msgid "The Payment Entry {0} is not balanced (difference {1})."
msgstr "سند الدفع {0} غير متوازن (الفرق {1})."

msgid "Received Amount is required for a transfer between {0} and {1}."
msgstr "المبلغ المستلم مطلوب للتحويل بين {0} و{1}."

msgid "Only Payment Entry and Journal Entry can be cleared here."
msgstr "يمكن هنا تسجيل صرف سندات الدفع وقيود اليومية فقط."

msgid "The bank account {0} is not credited by the voucher to reverse."
msgstr "الحساب البنكي {0} غير دائن في السند المراد عكسه."

# Messages (Treasury Company Settings: Bank Transfers)
msgid "{0} {1} must be a company bank account of {2}."
msgstr "يجب أن يكون {0} {1} حساباً بنكياً للشركة {2}."

msgid "The GL account of {0} {1} must have Account Type 'Bank'."
msgstr "يجب أن يكون نوع الحساب في دفتر الأستاذ لـ {0} {1} هو 'بنك'."

msgid "Row #{0}: Amount To must be 0 or not less than Amount From."
msgstr "الصف #{0}: يجب أن يكون \"المبلغ إلى\" صفراً أو لا يقل عن \"المبلغ من\"."

msgid "Row #{0}: {1} must be between 0 and 100."
msgstr "الصف #{0}: يجب أن يكون {1} بين 0 و100."

msgid "Row #{0}: Max Fee must be 0 or not less than Min Fee."
msgstr "الصف #{0}: يجب أن يكون الحد الأقصى للرسم صفراً أو لا يقل عن الحد الأدنى."

msgid "Row #{0}: Charge Bearer and Correspondent Fee apply to SWIFT only."
msgstr "الصف #{0}: متحمل الرسوم ورسم البنك المراسل خاصان بتحويلات سويفت فقط."

msgid "Row #{0}: Scope International is only for SWIFT."
msgstr "الصف #{0}: النطاق الدولي خاص بتحويلات سويفت فقط."

msgid "Rows #{0} and #{1} overlap for Bank Account {2}, {3}."
msgstr "الصفان #{0} و#{1} متداخلان للحساب البنكي {2}، {3}."

msgid "Row #{0}: Bank Account {1} already has a limit for {2}."
msgstr "الصف #{0}: للحساب البنكي {1} حد بالفعل للطريقة {2}."

