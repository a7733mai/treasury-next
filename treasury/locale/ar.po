msgstr "حساب الرسوم"

msgid "Repayment Schedule"
msgstr "جدول السداد"

msgid "Generated from the terms (Generate Schedule); may be adjusted before submit as long as the principal adds up to the amount."
msgstr "يُنشأ من الشروط (إنشاء الجدول)، ويمكن تعديله قبل الاعتماد طالما أن مجموع الأصل يساوي المبلغ."

msgid "Total Principal"
msgstr "إجمالي الأصل"

msgid "Total Interest / Profit"
msgstr "إجمالي الفائدة / الربح"

msgid "Total Payable"
msgstr "إجمالي المستحق"

