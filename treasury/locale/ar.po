# Party payment rules (treasury.accounting.posting)
msgid "Invalid party rule action {0}."
msgstr "إجراء قاعدة الطرف {0} غير صالح."

msgid "Conflicting party accounts for {0} {1}: {2} and {3}."
msgstr "حسابات متعارضة للطرف {0} {1}: {2} و{3}."

