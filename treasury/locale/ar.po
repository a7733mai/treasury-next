msgid "Drawdown {0} exceeds the available {1} limit of Bank Facility {2}: available {3} (total available {4})."
msgstr "السحب {0} يتجاوز المتاح من حد {1} في التسهيل البنكي {2}: المتاح {3} (إجمالي المتاح {4})."

msgid "Limit Exceeded"
msgstr "تم تجاوز الحد"

msgid "The schedule can only be generated on a draft drawdown."
msgstr "لا يمكن إنشاء الجدول إلا لسحب في حالة مسودة."

msgid "Drawdown {0} has submitted repayments ({1}). Cancel them first."
msgstr "للسحب {0} عمليات سداد معتمدة ({1}). ألغها أولاً."

msgid "Facility Drawdown {0} is not submitted."
msgstr "السحب من التسهيل {0} غير معتمد."

msgid "The Repayment Date cannot be before the Drawdown Date {0}."
msgstr "لا يمكن أن يكون تاريخ السداد قبل تاريخ السحب {0}."

msgid "The Repayment Date cannot be before the latest submitted repayment ({0})."
msgstr "لا يمكن أن يكون تاريخ السداد قبل آخر سداد معتمد ({0})."

msgid "{0} cannot be negative."
msgstr "لا يمكن أن يكون {0} سالباً."

msgid "Enter the principal, interest or penalty paid."
msgstr "أدخل الأصل أو الفائدة أو الغرامة المدفوعة."

msgid "Penalty Account is required for the penalty."
msgstr "حساب الغرامات مطلوب للغرامة."

msgid "Penalty Account {0} must be a ledger Expense account of {1} in {2}."
msgstr "يجب أن يكون حساب الغرامات {0} حساب مصروفات فرعياً للشركة {1} بعملة {2}."

