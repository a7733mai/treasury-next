msgid "Limit Type must be one of: {0}."
msgstr "يجب أن يكون نوع الحد أحد: {0}."

msgid "Set the Liability Account of the {0} sub-limit of Bank Facility {1}."
msgstr "حدد حساب الالتزام للحد الفرعي {0} في التسهيل البنكي {1}."

