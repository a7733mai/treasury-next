# Messages (Bank Transfer controller and lifecycle)
msgid "Transfer Limit Exceeded"
msgstr "تم تجاوز حد التحويل"

msgid "Beneficiary SWIFT / BIC is required for a SWIFT transfer."
msgstr "رمز سويفت / BIC للمستفيد مطلوب لتحويل سويفت."

msgid "Beneficiary IBAN or Bank Account is required."
msgstr "رقم آيبان المستفيد أو حسابه البنكي مطلوب."

msgid "Bank Reference cannot be changed while the transfer is {0}."
msgstr "لا يمكن تغيير مرجع البنك والتحويل في حالة {0}."

msgid "The target Bank Account is required for an Internal Transfer."
msgstr "الحساب البنكي المستهدف مطلوب للتحويل الداخلي."

msgid "The source and target Bank Accounts must be different."
msgstr "يجب أن يختلف الحساب البنكي المصدر عن الحساب البنكي المستهدف."

msgid "The fee cannot be negative."
msgstr "لا يمكن أن يكون الرسم سالباً."

msgid "A reason is required to override the fee."
msgstr "يلزم ذكر سبب لتعديل الرسم."

msgid "Set the Expense Account of the fee (Transfer Fee Rule or Fee Account)."
msgstr "حدد حساب مصروف الرسم (قاعدة رسوم التحويل أو حساب الرسوم)."

msgid "The fee must be less than the amount."
msgstr "يجب أن يكون الرسم أقل من المبلغ."

msgid "The total allocated amount cannot be greater than the transfer amount."
msgstr "لا يمكن أن يزيد إجمالي المبلغ المخصص على مبلغ التحويل."

msgid "Bank Transfer {0} ({1})"
msgstr "تحويل بنكي {0} ({1})"

msgid "Transfers above {0} must be submitted by a Treasury Manager."
msgstr "التحويلات التي تزيد على {0} يجب أن يعتمدها مدير الخزينة."

msgid "Bank Transfer {0} is completed and cannot be cancelled. Return it instead."
msgstr "التحويل البنكي {0} مكتمل ولا يمكن إلغاؤه. سجّل ارتجاعه بدلاً من ذلك."

msgid "Bank Transfer {0} is returned and cannot be cancelled."
msgstr "التحويل البنكي {0} مرتجع ولا يمكن إلغاؤه."

msgid "{0} {1} could not be cancelled (see the message above)."
msgstr "تعذر إلغاء {0} {1} (انظر الرسالة أعلاه)."

msgid "Use Reschedule for a future date."
msgstr "استخدم إعادة الجدولة لتاريخ مستقبلي."

msgid "The new execution date must be in the future; use Send Now to send it today."
