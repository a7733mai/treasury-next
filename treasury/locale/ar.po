msgid "The date {0} is outside the facility period {1} - {2}."
msgstr "التاريخ {0} خارج فترة التسهيل {1} - {2}."

msgid "{0} of {1} exceeds the available {2} limit of Bank Facility {3}: available {4} (total available {5})."
msgstr "{0} بمبلغ {1} يتجاوز المتاح من حد {2} في التسهيل البنكي {3}: المتاح {4} (إجمالي المتاح {5})."

msgid "{0} {1} must be submitted first."
msgstr "يجب اعتماد {0} {1} أولاً."

msgid "{0} can only be changed by the {1} actions."
msgstr "لا يمكن تغيير {0} إلا من خلال إجراءات {1}."

msgid "{0} {1} is already {2}."
msgstr "{0} {1} بالفعل {2}."

msgid "This action is not allowed while {0} {1} is {2}."
msgstr "هذا الإجراء غير مسموح به بينما {0} {1} {2}."

msgid "Cash margin of {0} {1}"
msgstr "التأمين النقدي لـ {0} {1}"

msgid "Cash margin released of {0} {1}"
msgstr "الإفراج عن التأمين النقدي لـ {0} {1}"

msgid "Commission of {0} {1}"
msgstr "عمولة {0} {1}"

