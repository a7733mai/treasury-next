msgid "The Claim Account must be in {0} or in the company currency {1}."
msgstr "يجب أن يكون حساب التسييل بعملة {0} أو بعملة الشركة {1}."

msgid "Select the party of the Claim Account {0}."
msgstr "اختر الطرف لحساب التسييل {0}."

msgid "A party can only be given with a Payable or Receivable Claim Account."
msgstr "لا يمكن تحديد طرف إلا مع حساب تسييل من نوع دائنين أو مدينين."

msgid "Letter of Guarantee {0} was claimed and cannot be cancelled."
msgstr "تم تسييل خطاب الضمان {0} ولا يمكن إلغاؤه."

msgid "The Expiry Date must be after the Issue Date."
msgstr "يجب أن يكون تاريخ الانتهاء بعد تاريخ الإصدار."

msgid "Enter the Beneficiary Name."
msgstr "أدخل اسم المستفيد."

msgid "Select the Beneficiary."
