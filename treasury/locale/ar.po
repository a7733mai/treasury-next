# Facility Repayment
msgid "A repayment of a Facility Drawdown: principal and interest / profit allocated to its repayment schedule, an optional penalty and an optional prepayment."
msgstr "سداد لسحب من تسهيل: أصل وفائدة / ربح موزعان على جدول سداده، مع غرامة اختيارية وسداد معجل اختياري."

msgid "Repayment Date"
msgstr "تاريخ السداد"

msgid "Facility currency to company currency, on the repayment date."
msgstr "من عملة التسهيل إلى عملة الشركة في تاريخ السداد."

msgid "The company bank account debited (default: the drawdown's bank account), in the facility currency."
msgstr "الحساب البنكي للشركة الذي يُخصم منه (افتراضياً: الحساب البنكي للسحب) بعملة التسهيل."

msgid "Total Paid"
msgstr "إجمالي المدفوع"

msgid "Amounts"
msgstr "المبالغ"

msgid "Oldest First"
msgstr "الأقدم أولاً"

msgid "Selected Row"
msgstr "القسط المحدد"

msgid "Principal Paid"
msgstr "الأصل المدفوع"

msgid "Leave the principal and the interest empty to pay the next unpaid installment (or the selected one)."
msgstr "اترك الأصل والفائدة فارغين لسداد القسط التالي غير المدفوع (أو القسط المحدد)."

msgid "Interest / Profit Paid"
msgstr "الفائدة / الربح المدفوع"

msgid "Principal beyond the installments due up to the repayment date is an early repayment: the later installments are reduced (the tenor is kept)."
msgstr "ما يزيد من الأصل على الأقساط المستحقة حتى تاريخ السداد هو سداد معجل: تُخفَّض الأقساط اللاحقة (مع الإبقاء على المدة)."

msgid "Prepayment Amount"
msgstr "مبلغ السداد المعجل"

msgid "Penalty"
msgstr "الغرامة"

msgid "Penalty Account"
msgstr "حساب الغرامات"

msgid "Allocation to Installments"
msgstr "التوزيع على الأقساط"

msgid "Allocations"
msgstr "التوزيعات"

msgid "Accrued Interest Cleared"
msgstr "الفوائد المستحقة المسوّاة"

msgid "The part of the interest paid that clears interest already accrued (Accrued Interest Account)."
msgstr "جزء الفائدة المدفوعة الذي يسوّي فوائد سبق استحقاقها (حساب الفوائد المستحقة)."

msgid "Interest Expensed"
msgstr "الفائدة المحمّلة على المصروفات"

msgid "The part of the interest paid booked straight to the Interest Expense Account."
msgstr "جزء الفائدة المدفوعة المسجل مباشرة في حساب مصروف الفوائد."

msgid "Schedule Snapshot"
msgstr "لقطة الجدول"

# Messages (facility actions)
msgid "Bank Facility {0} expired on {1}. Renew it instead."
msgstr "انتهى التسهيل البنكي {0} في {1}. قم بتجديده بدلاً من ذلك."

msgid "Bank Facility {0} cannot be closed: {1} is still utilised."
msgstr "لا يمكن إغلاق التسهيل البنكي {0}: لا يزال {1} مستخدماً."

msgid "Bank Facility {0} cannot be closed: drawdowns {1} still have unpaid installments."
msgstr "لا يمكن إغلاق التسهيل البنكي {0}: لا تزال للمسحوبات {1} أقساط غير مدفوعة."

msgid "The new Expiry Date cannot be before the Renewal Date."
msgstr "لا يمكن أن يكون تاريخ الانتهاء الجديد قبل تاريخ التجديد."

msgid "New limits must be given as {limit type: amount}."
msgstr "يجب إدخال الحدود الجديدة بالصيغة {نوع الحد: المبلغ}."

msgid "Bank Facility {0} has no {1} sub-limit."
msgstr "لا يوجد في التسهيل البنكي {0} حد فرعي من نوع {1}."

msgid "Bank Facility {0} is already {1}."
msgstr "التسهيل البنكي {0} بالفعل {1}."

msgid "This action is not allowed while Bank Facility {0} is {1}."
msgstr "هذا الإجراء غير مسموح به بينما التسهيل البنكي {0} {1}."

msgid "The date ({0}) cannot be before {1}."
msgstr "لا يمكن أن يكون التاريخ ({0}) قبل {1}."

msgid "Bank Facility {0} cannot be deleted once activated or when it has drawdowns. Close it instead."
msgstr "لا يمكن حذف التسهيل البنكي {0} بعد تفعيله أو عند وجود مسحوبات عليه. قم بإغلاقه بدلاً من ذلك."

msgid "{0} can only be changed by the Bank Facility actions."
msgstr "لا يمكن تغيير {0} إلا من خلال إجراءات التسهيل البنكي."

msgid "The Expiry Date cannot be before the Start Date."
msgstr "لا يمكن أن يكون تاريخ الانتهاء قبل تاريخ البدء."

msgid "Total Limit must be greater than zero."
msgstr "يجب أن يكون الحد الإجمالي أكبر من صفر."

msgid "Add at least one sub-limit."
msgstr "أضف حداً فرعياً واحداً على الأقل."

msgid "Row #{0}: Sub-limit {1} appears more than once."
msgstr "الصف رقم {0}: الحد الفرعي {1} مكرر."

msgid "Row #{0}: Limit Amount must be greater than zero."
msgstr "الصف رقم {0}: يجب أن يكون مبلغ الحد أكبر من صفر."

msgid "Row #{0}: Limit Amount {1} cannot exceed the Total Limit {2}."
msgstr "الصف رقم {0}: لا يمكن أن يتجاوز مبلغ الحد {1} الحد الإجمالي {2}."

msgid "Row #{0}: {1} cannot be negative."
msgstr "الصف رقم {0}: لا يمكن أن يكون {1} سالباً."

msgid "Row #{0}: Liability Account is required for sub-limit {1}."
msgstr "الصف رقم {0}: حساب الالتزام مطلوب للحد الفرعي {1}."

msgid "Row #{0}: Liability Account"
msgstr "الصف رقم {0}: حساب الالتزام"

msgid "Default Bank Account is required for an Overdraft sub-limit."
msgstr "الحساب البنكي الافتراضي مطلوب لحد السحب على المكشوف."

msgid "Bank Account {0} is not at bank {1}."
msgstr "الحساب البنكي {0} ليس لدى البنك {1}."

msgid "Bank Account {0} is in {1}, but the facility is in {2}."
msgstr "الحساب البنكي {0} بعملة {1}، لكن التسهيل بعملة {2}."

msgid "{0} {1} cannot be a Payable or Receivable account."
msgstr "لا يمكن أن يكون {0} {1} حساب دائنين أو مدينين."

msgid "{0} {1} must be in {2}."
msgstr "يجب أن يكون {0} {1} بعملة {2}."

msgid "Row #{0}: Security Cheque {1} appears more than once."
msgstr "الصف رقم {0}: شيك الضمان {1} مكرر."

msgid "Row #{0}: Security Cheque {1} does not belong to company {2}."
msgstr "الصف رقم {0}: شيك الضمان {1} لا يخص الشركة {2}."

msgid "{0} cannot be changed after the facility is activated. Use the Renew action."
msgstr "لا يمكن تغيير {0} بعد تفعيل التسهيل. استخدم إجراء التجديد."

# Messages (accounting, schedule, accrual, repayments)
msgid "Drawdown {0} of Bank Facility {1}"
msgstr "السحب {0} من التسهيل البنكي {1}"

msgid "Upfront fees of drawdown {0}"
msgstr "الرسوم المقدمة للسحب {0}"

msgid "Set the Interest Expense Account of Bank Facility {0}."
msgstr "حدد حساب مصروف الفوائد للتسهيل البنكي {0}."

msgid "Repayment {0} of drawdown {1}"
msgstr "السداد {0} للسحب {1}"

msgid "Set the {0} of Bank Facility {1}."
msgstr "حدد {0} للتسهيل البنكي {1}."

msgid "Interest accrual of drawdown {0} for {1}"
msgstr "استحقاق فوائد السحب {0} عن {1}"

msgid "Invalid Repayment Frequency: {0}"
msgstr "دورية سداد غير صالحة: {0}"

msgid "Invalid Day Count: {0}"
msgstr "أساس حساب أيام غير صالح: {0}"

msgid "Tenor (Months) must be greater than zero."
msgstr "يجب أن تكون المدة (بالأشهر) أكبر من صفر."

msgid "Invalid Repayment Method: {0}"
msgstr "طريقة سداد غير صالحة: {0}"

msgid "The interest rate and the profit amount cannot be negative."
msgstr "لا يمكن أن يكون سعر الفائدة أو مبلغ الربح سالباً."

msgid "Tenor (Months) {0} must be a multiple of the {1} months of a {2} period."
msgstr "يجب أن تكون المدة (بالأشهر) {0} من مضاعفات أشهر الفترة ({1}) لدورية {2}."

msgid "Grace (Months) must be a multiple of the {0} months of a {1} period."
msgstr "يجب أن تكون فترة السماح (بالأشهر) من مضاعفات أشهر الفترة ({0}) لدورية {1}."

msgid "The grace period must end before the last installment."
msgstr "يجب أن تنتهي فترة السماح قبل القسط الأخير."

msgid "The First Repayment Date must be after the drawdown date."
msgstr "يجب أن يكون تاريخ أول سداد بعد تاريخ السحب."

msgid "The interest of installment {0} exceeds the installment {1}."
msgstr "فائدة القسط {0} تتجاوز قيمة القسط {1}."

msgid "Facility interest accrual failed for drawdown {0}"
msgstr "فشل استحقاق فوائد التسهيل للسحب {0}"

msgid "Installment {0} does not exist on drawdown {1}."
msgstr "القسط {0} غير موجود في السحب {1}."

msgid "The interest paid exceeds the unpaid interest of the allocated installments by {0}."
msgstr "الفائدة المدفوعة تتجاوز الفائدة غير المدفوعة للأقساط الموزع عليها بمقدار {0}."

msgid "The principal paid exceeds the unpaid principal of the allocated installments by {0}. Tick Prepayment to prepay it."
msgstr "الأصل المدفوع يتجاوز الأصل غير المدفوع للأقساط الموزع عليها بمقدار {0}. حدد السداد المعجل لسداده مبكراً."

msgid "The prepayment {0} exceeds the principal {1} of the unpaid installments due after the repayment date."
msgstr "السداد المعجل {0} يتجاوز أصل الأقساط غير المدفوعة المستحقة بعد تاريخ السداد ({1})."

msgid "Schedule row {0} no longer exists."
msgstr "سطر الجدول {0} لم يعد موجوداً."

msgid "Cancel the later repayments of drawdown {0} first: {1}."
msgstr "ألغِ أولاً عمليات السداد اللاحقة للسحب {0}: {1}."

msgid "The prepayment exceeds the principal of the unpaid installments due after the repayment date."
msgstr "السداد المعجل يتجاوز أصل الأقساط غير المدفوعة المستحقة بعد تاريخ السداد."

