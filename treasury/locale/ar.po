msgid "The new Expiry Date cannot be before the extension date."
msgstr "لا يمكن أن يكون تاريخ الانتهاء الجديد قبل تاريخ التمديد."

msgid "Extension commission of {0} {1}"
msgstr "عمولة تمديد {0} {1}"

msgid "The new amount must be greater than zero and less than the open amount {0}."
msgstr "يجب أن يكون المبلغ الجديد أكبر من صفر وأقل من المبلغ القائم {0}."

msgid "The claim amount must be greater than zero and at most the open amount {0}."
msgstr "يجب أن يكون مبلغ التسييل أكبر من صفر وألا يتجاوز المبلغ القائم {0}."

msgid "Select the account to debit with the claim."
msgstr "اختر الحساب المدين بمبلغ التسييل."

msgid "Claim of {0} {1}"
msgstr "تسييل {0} {1}"

msgid "Nothing of the claim of {0} is owed to the bank."
msgstr "لا يوجد مستحق للبنك من تسييل {0}."

msgid "The amount must be greater than zero and at most the amount owed {0}."
msgstr "يجب أن يكون المبلغ أكبر من صفر وألا يتجاوز المبلغ المستحق {0}."

msgid "Repayment of the claim of {0} {1}"
msgstr "سداد تسييل {0} {1}"

msgid "Set the Liability Account of the {0} sub-limit of Bank Facility {1}: the bank-funded part of a claim is booked on it."
