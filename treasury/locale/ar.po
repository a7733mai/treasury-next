# Messages
msgid "Outgoing cheques will be posted to the party as soon as they are created, even if they are never handed over."
msgstr "سيتم ترحيل الشيكات الصادرة على الطرف بمجرد إنشائها، حتى لو لم يتم تسليمها أبداً."

msgid "Row #{0}: Bank Account {1} appears more than once."
msgstr "الصف #{0}: الحساب البنكي {1} مكرر أكثر من مرة."

msgid "Row #{0}: {1} {2} must have Account Type 'Bank'."
msgstr "الصف #{0}: يجب أن يكون نوع الحساب {1} {2} هو 'بنك'."

msgid "Row #{0}: {1} {2} must have Root Type '{3}'."
msgstr "الصف #{0}: يجب أن يكون النوع الرئيسي للحساب {1} {2} هو '{3}'."

msgid "Row #{0}: {1} {2} must be in the bank account currency {3}."
msgstr "الصف #{0}: يجب أن يكون الحساب {1} {2} بعملة الحساب البنكي {3}."

msgid "Row #{0}: Bank Account {1} must be a company bank account of {2}."
msgstr "الصف #{0}: يجب أن يكون الحساب البنكي {1} حساباً بنكياً للشركة {2}."

msgid "Row #{0}: {1} {2} does not belong to company {3}."
msgstr "الصف #{0}: {1} {2} لا يتبع الشركة {3}."

msgid "{0} {1} does not belong to company {2}."
msgstr "{0} {1} لا يتبع الشركة {2}."

msgid "Row #{0}: {1} {2} cannot be a group account."
msgstr "الصف #{0}: {1} {2} لا يمكن أن يكون حساباً رئيسياً (مجموعة)."

msgid "{0} {1} cannot be a group account."
msgstr "{0} {1} لا يمكن أن يكون حساباً رئيسياً (مجموعة)."

msgid "{0} {1} must have Root Type '{2}'."
msgstr "يجب أن يكون النوع الرئيسي للحساب {0} {1} هو '{2}'."

msgid "Row #{0}: {1} {2} must be in the company currency {3}."
msgstr "الصف #{0}: يجب أن يكون الحساب {1} {2} بعملة الشركة {3}."

msgid "{0} {1} must be in the company currency {2}."
msgstr "يجب أن يكون الحساب {0} {1} بعملة الشركة {2}."

msgid "Row #{0}: {1} is required when {2} is '{3}'."
msgstr "الصف #{0}: {1} مطلوب عندما تكون قيمة {2} هي '{3}'."

msgid "Row #{0}: The GL account of Bank Account {1} must have Account Type 'Bank'."
msgstr "الصف #{0}: يجب أن يكون نوع الحساب في دليل الحسابات المرتبط بالحساب البنكي {1} هو 'بنك'."

msgid "This voucher is managed by {0} {1}. Cancel it from there."
msgstr "هذا السند تتم إدارته من {0} {1}. قم بإلغائه من هناك."

msgid "Treasury Company Settings are missing for company {0}."
msgstr "إعدادات الخزينة غير موجودة للشركة {0}."

msgid "Missing Settings"
msgstr "إعدادات ناقصة"

msgid "No PDC account mapping found for Bank Account {0} in Treasury Company Settings {1}."
msgstr "لا يوجد ربط لحسابات الشيكات للحساب البنكي {0} في إعدادات الخزينة للشركة {1}."

msgid "{0} {1} does not exist"
msgstr "{0} {1} غير موجود"

msgid "Payment Type must be Pay or Receive."
msgstr "يجب أن يكون نوع الدفع صرف أو قبض."

msgid "Currency {0} does not match the currency {1} of account {2}."
msgstr "العملة {0} لا تطابق عملة الحساب {2} وهي {1}."

msgid "No party account found for {0} {1}."
msgstr "لم يتم العثور على حساب للطرف {0} {1}."

msgid "Exchange rate from {0} to {1} is required."
msgstr "سعر الصرف من {0} إلى {1} مطلوب."

msgid "Amount must be greater than zero."
msgstr "يجب أن يكون المبلغ أكبر من صفر."

msgid "Party account currency {0} must be either {1} or the company currency {2}."
msgstr "عملة حساب الطرف {0} يجب أن تكون {1} أو عملة الشركة {2}."

msgid "The following references are no longer outstanding enough and were reduced or skipped: {0}. The difference is kept as an unallocated advance."
msgstr "المستندات التالية لم يعد رصيدها المستحق كافياً فتم تخفيض التخصيص عليها أو تخطيها: {0}. الفرق مسجل كدفعة مقدمة غير مخصصة."

msgid "The following references were reduced or skipped because the payment amount is already fully allocated: {0}."
msgstr "المستندات التالية تم تخفيض التخصيص عليها أو تخطيها لأن مبلغ الدفعة تم تخصيصه بالكامل: {0}."

msgid "Allocation Adjusted"
msgstr "تم تعديل التخصيص"

msgid "{0} {1} is allocated against Journal Entry {2} and cannot be reversed by a Journal Entry. Cancel it instead."
msgstr "{0} {1} مخصص مقابل قيد اليومية {2} ولا يمكن عكسه بقيد يومية. قم بإلغائه بدلاً من ذلك."

msgid "Reversal Not Possible"
msgstr "لا يمكن العكس"

msgid "Reference type {0} is not supported."
msgstr "نوع المستند المرجعي {0} غير مدعوم."

msgid "Treasury cycle must be a positive whole number."
msgstr "يجب أن تكون دورة الخزينة عدداً صحيحاً موجباً."

msgid "Clearance Date can only be set on a submitted Journal Entry."
msgstr "لا يمكن تحديد تاريخ الصرف إلا على قيد يومية معتمد."

msgid "At least one account row is required."
msgstr "مطلوب سطر حساب واحد على الأقل."

msgid "Only Payment Entry and Journal Entry can be cancelled here."
msgstr "يمكن إلغاء سندات الدفع وقيود اليومية فقط من هنا."

msgid "{0} {1} must be submitted to be reversed."
msgstr "يجب اعتماد {0} {1} حتى يمكن عكسه."

msgid "{0} {1} is not managed by Treasury."
msgstr "{0} {1} لا تتم إدارته من الخزينة."

msgid "Reversal of {0} {1}"
msgstr "عكس {0} {1}"

msgid "Exchange rate is required for account {0}."
msgstr "سعر الصرف مطلوب للحساب {0}."

msgid "Set the Exchange Gain / Loss Account in company {0}."
msgstr "حدد حساب أرباح / خسائر فروق العملة في الشركة {0}."

